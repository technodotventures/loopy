{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/technodotventures/loopy/schema/records/cycle-report.schema.json",
  "title": "Cycle report",
  "description": "The summary of one cycle. Stored as .loopy/cycles/<n>/report.json next to report.md. Written by the report agent.",
  "type": "object",
  "required": ["type", "cycle", "window", "budget_used", "shipped", "rejected"],
  "properties": {
    "type": { "const": "cycle_report" },
    "cycle": { "type": "integer", "minimum": 1 },
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "budget_used": {
      "type": "object",
      "required": ["usd", "cap_usd"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "usd": { "type": "number", "minimum": 0 },
        "cap_usd": { "type": "number", "minimum": 0 },
        "by_pool": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
      }
    },
    "shipped": { "type": "array", "items": { "type": "string" }, "description": "Experiment ids kept and merged" },
    "rejected": { "type": "array", "items": { "type": "string" } },
    "carried": { "type": "array", "items": { "type": "string" }, "description": "Proposal ids moved to the next cycle" },
    "primary": { "type": "object", "properties": { "start": { "type": "number" }, "end": { "type": "number" } } },
    "sealed_scores": { "type": "object", "additionalProperties": { "type": "number" } },
    "overfit_flag": { "type": "boolean", "description": "Sealed score fell while the dev score rose" },
    "lessons": { "type": "array", "items": { "type": "string" } }
  }
}
